# ============================================================
# AI ASO Platform - Environment Configuration
# Copy this file to .env and fill in real values.
# ============================================================

# --- App ---
APP_NAME=AI ASO Platform
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Database ---
# SQLite by default (zero setup). Swap to Postgres for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/aso_platform
DATABASE_URL=sqlite:///./data/db/aso_platform.db

# --- Agent Runtime ---
# Which runtime backend powers telemetry / remote task dispatch.
# "mock" works out of the box for local dev/testing.
# "openfang_zeroclaw" talks to a running ZeroClaw gateway
#   (zeroclaw gateway → default http://127.0.0.1:42617).
AGENT_RUNTIME=mock
OPENFANG_ZEROCLAW_API_KEY=          # Bearer token from POST /pair
OPENFANG_ZEROCLAW_BASE_URL=         # e.g. http://127.0.0.1:42617

# --- Orchestration ---
# "direct" = CoordinatorAgent Python pipeline (default, no LLM required)
# "crewai" = CrewAI crew wrapping the same agents as tools (needs an LLM key)
ORCHESTRATION_MODE=direct

# --- LLM Provider (used by CrewAI agents for reasoning) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Data source APIs / scraping ---
APP_STORE_COUNTRY=us
GOOGLE_PLAY_COUNTRY=us
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

# --- Scheduler ---
DAILY_REPORT_HOUR=6          # 24h format, server local time
WEEKLY_REPORT_DAY=mon        # mon|tue|wed|thu|fri|sat|sun
WEEKLY_REPORT_HOUR=7

# --- Reports ---
REPORTS_OUTPUT_DIR=./data/reports

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
